<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for a USB file browser tile (config.xml, app_banners): a blue field with a USB pen drive. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF3B82F6" android:endColor="#FF1E3A8A" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_usb" />
</layer-list>
